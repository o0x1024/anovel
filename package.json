{
  "name": "anovel",
  "version": "2.5.0",
  "type": "module",
  "description": "AI主导的小说创作辅助系统",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test:systemic": "jiti scripts/test-novel-systemic.ts",
    "test:emotion-ledger": "jiti scripts/test-emotion-ledger.ts",
    "test:forensic-repair": "jiti scripts/test-story-forensic-repair.ts",
    "test:story-beat-staging": "jiti scripts/test-story-beat-staging.ts",
    "test:continuity-repair": "jiti scripts/test-story-continuity-repair-policy.ts",
    "test:continuity-escalation": "jiti scripts/test-story-continuity-escalation.ts",
    "test:zhuque-alignment": "jiti scripts/test-perplexity-model-registry.ts && jiti scripts/test-zhuque-experiment-corpus.ts && jiti scripts/test-zhuque-alignment.ts",
    "evaluate:zhuque-supervised": "jiti scripts/evaluate-aigc-supervised-corpus.ts",
    "test:aigc-supervised": "jiti scripts/test-aigc-supervised-fusion.ts && jiti scripts/test-aigc-supervised-tokenizer.ts",
    "test:aigc-rewrite": "jiti scripts/test-aigc-rewrite-quality.ts && jiti scripts/test-aigc-sentence-patches.ts && jiti scripts/test-zhuque-sentence-attribution.ts && jiti scripts/test-aigc-display-allocation.ts && jiti scripts/test-aigc-rewrite-verification.ts && jiti scripts/test-human-rewrite-reference.ts && jiti scripts/test-human-rewrite-reference-presets.ts && node scripts/run-electron-test.mjs scripts/test-human-rewrite-reference-db.ts",
    "dataset:sft": "node scripts/gen-sft-dataset.mjs",
    "test:continuation-dataset": "node scripts/test-continuation-dataset.mjs",
    "evaluate:finetuned-continuation": "node scripts/evaluate-finetuned-continuation.mjs",
    "test:novel-volume-staging": "jiti scripts/test-novel-volume-staging.ts",
    "test:novel-harness": "jiti scripts/test-novel-harness.ts",
    "test:causal-novel": "jiti scripts/test-causal-novel.ts && node scripts/run-electron-test.mjs scripts/test-causal-novel-db.ts",
    "test:novel-memory-commit": "node scripts/run-electron-test.mjs scripts/test-novel-memory-commit-db.ts",
    "test:novel-volume-state": "node scripts/run-electron-test.mjs scripts/test-novel-volume-state-db.ts",
    "test:structural-repair": "jiti scripts/test-story-structural-repair-policy.ts",
    "test:story-harness": "jiti scripts/test-story-harness.ts && jiti scripts/test-model-json-repair.ts && jiti scripts/test-structured-model-output.ts && node scripts/run-electron-test.mjs scripts/test-story-harness-db.ts",
    "postinstall": "node scripts/rebuild-native.mjs",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "icons": "node scripts/generate-app-icon.mjs",
    "pack:mac": "electron-vite build && electron-builder --mac --arm64",
    "pack:win": "electron-vite build && electron-builder --win --x64",
    "release:mac": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "release:win": "electron-vite build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^11.7.0",
    "dompurify": "^3.4.7",
    "mammoth": "^1.12.0",
    "marked": "^18.0.4",
    "node-llama-cpp": "^3.18.1",
    "onnxruntime-node": "^1.27.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.2.0",
    "@tiptap/starter-kit": "^2.11.2",
    "@tiptap/vue-3": "^2.11.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "daisyui": "^5.5.20",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "pinia": "^2.3.0",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "build": {
    "appId": "com.anovel.app",
    "productName": "ANovel",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*",
      "node_modules/onnxruntime-common/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "o0x1024",
      "repo": "anovel"
    }
  }
}
